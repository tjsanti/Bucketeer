{
  "name": "bucketeer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "bucketeer": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.ts",
    "start": "node dist/server.js",
    "bucketeer": "node dist/cli.js",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "test:ui": "npm run build && tsc -p tsconfig.test.json && node --test .test-dist/test/browser/*.test.js",
    "acceptance": "node scripts/acceptance.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.0"
  }
}
